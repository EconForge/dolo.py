@name: RBC_Dolo

# RBC Model (Dolo-style timing)
# Converted from dolo.py examples/models/rbc.yaml
# Timing convention: transitions define states at t from t-1 inputs

# Parameters
beta <- 0.99
sigma <- 5
eta <- 1
delta <- 0.025
alpha <- 0.33
rho <- 0.8
zbar <- 0
sig_z <- 0.016

# Steady state
n[~] <- 0.33
z[~] <- zbar
rk[~] <- 1/beta - 1 + delta
k[~] <- n[~]/(rk[~]/alpha)^(1/(1-alpha))
y[~] <- exp(z[~])*k[~]^alpha*n[~]^(1-alpha)
w[~] <- (1-alpha)*y[~]/n[~]
i[~] <- delta*k[~]
c[~] <- y[~] - i[~]
chi <- w[~]/c[~]^sigma/n[~]^eta

# Exogenous
e_z[t] <- N(0, sig_z^2)

# Definitions: auxiliary variables (recursive block)
[definitions] :: {
    y[t] = exp(z[t])*k[t]^alpha*n[t]^(1-alpha)
    c[t] = y[t] - i[t]
    rk[t] = alpha*y[t]/k[t]
    w[t] = (1-alpha)*y[t]/n[t]
}

# Transition equations: s[t] = f(m[t-1], s[t-1], x[t-1], M[t])
[transition] :: {
    z[t] = rho*z[t-1] + e_z[t]
    k[t] = (1-delta)*k[t-1] + i[t-1]
}

# Arbitrage equations: g(m[t], s[t], x[t], m[t+1], s[t+1], x[t+1]) = 0
[arbitrage] :: {
    chi*n[t]^eta*c[t]^sigma - w[t]
    1 - beta*(c[t]/c[t+1])^sigma*(1-delta+rk[t+1])
}

@run: steady
@run: check
@run: solve
@run: simulate: {T: 40}
@run: plot
